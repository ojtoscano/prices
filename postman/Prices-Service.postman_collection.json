  "item": [
    {
      "name": "Escenario 1 - 14/06/2020 10:00 - tarifa 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/prices?applicationDate=2020-06-14T10:00:00&productId=35455&brandId=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prices"],
          "query": [
            { "key": "applicationDate", "value": "2020-06-14T10:00:00" },
            { "key": "productId", "value": "35455" },
            { "key": "brandId", "value": "1" }
          ]
        }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('responde con 200 OK', function () { pm.response.to.have.status(200); });",
        "const body = pm.response.json();",
        "pm.test('devuelve la tarifa 1 y el precio 35.50 EUR', function () {",
        "    pm.expect(body.productId).to.eql(35455);",
        "    pm.expect(body.brandId).to.eql(1);",
        "    pm.expect(body.tariffId).to.eql(1);",
        "    pm.expect(body.amount).to.eql(35.5);",
        "    pm.expect(body.currencyCode).to.eql('EUR');",
        "    pm.expect(body.startDate).to.eql('2020-06-14T00:00:00');",
        "    pm.expect(body.endDate).to.eql('2020-12-31T23:59:59');",
        "});"
      ], "type": "text/javascript" } }]
